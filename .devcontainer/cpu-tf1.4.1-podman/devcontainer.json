{
    "name": "Python 3 CPU - TF 1.4.1 - Podman",
    "build": {
        "dockerfile": "../cpu-tf1.4.1-docker/Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "REditorSupport.r"
            ]
        }
    },
    "forwardPorts": [],
    "postCreateCommand": {
        "python-install-requirements": "python -m pip install --upgrade pip && python -m pip install -r requirements.txt",
        "r-install-requirements": "RScript ./scripts/install.R"
    }
}