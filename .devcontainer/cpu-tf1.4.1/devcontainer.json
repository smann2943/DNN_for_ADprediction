{
    "name": "Python 3 CPU - TF 1.4.1 - Podman",
    "build": {
        "dockerfile": "./Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "REditorSupport.r"
            ]
        }
    },
    "remoteEnv": {
        "VSCODE_SERVER_CUSTOM_GLIBC_PATH": "/opt/glibc-2.28/lib",
        "VSCODE_SERVER_CUSTOM_GLIBC_LINKER": "/opt/glibc-2.28/lib/ld-linux-x86-64.so.2",
        "VSCODE_SERVER_PATCHELF_PATH": "/usr/bin/patchelf"
    },
    "forwardPorts": [],
    "postCreateCommand": {
        "create-and-activate-venv": "python -m venv .venv",
        "r-install-requirements": "RScript ./scripts/install.R",
        "install-python-tensorflow": "python -m pip install --upgrade pip && python -m pip install /tmp/tensorflow-1.4.1-c35-linux_x86_64.whl"
    }
}