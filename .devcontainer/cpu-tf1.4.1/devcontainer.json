{
    "name": "Python 3 CPU - TF 1.4.1",
    "build": {
        "dockerfile": "./Dockerfile"
    },
    "runArgs": [
        "--name", "python3.6-fast"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "REditorSupport.r"
            ]
        }
    },    
    "forwardPorts": [],
    "postCreateCommand": {        
        "python-create-and-activate-venv": "python -m venv .venv",
        "python-install-requirements": ". .venv/bin/activate && python -m pip install --upgrade pip && python -m pip install -r requirements.txt"
    }
}